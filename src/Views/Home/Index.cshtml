@model TaskManager.Models.DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; Layout = "~/Views/Shared/_Layout.cshtml"; }

<div class="page-header">
    <div>
        <div class="page-title">Dashboard</div>
        <div class="page-subtitle">Welcome back, @Context.Session.GetString("UserName") 👋</div>
    </div>
    <a href="/Tasks/Create" class="btn btn-primary"><i class="fas fa-plus"></i> New Task</a>
</div>

<div class="grid-4">
    <div class="stat-card">
        <div class="stat-icon" style="background:#eff6ff;color:#3b82f6;"><i class="fas fa-list-check"></i></div>
        <div>
            <div class="stat-value" style="color:#3b82f6;">@Model.TotalTasks</div>
            <div class="stat-label">Total Tasks</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:#f0fdf4;color:#22c55e;"><i class="fas fa-circle-check"></i></div>
        <div>
            <div class="stat-value" style="color:#22c55e;">@Model.CompletedTasks</div>
            <div class="stat-label">Completed</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:#fffbeb;color:#f59e0b;"><i class="fas fa-spinner"></i></div>
        <div>
            <div class="stat-value" style="color:#f59e0b;">@Model.InProgressTasks</div>
            <div class="stat-label">In Progress</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:#fef2f2;color:#ef4444;"><i class="fas fa-triangle-exclamation"></i></div>
        <div>
            <div class="stat-value" style="color:#ef4444;">@Model.OverdueTasks</div>
            <div class="stat-label">Overdue</div>
        </div>
    </div>
</div>

<div class="grid-2">
    <div class="card">
        <div style="padding:18px 20px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;">
            <span style="font-weight:700;font-size:0.95rem;">Recent Tasks</span>
            <a href="/Tasks/Index" style="font-size:0.8rem;font-weight:600;">View all →</a>
        </div>
        @if (Model.RecentTasks.Any())
        {
        <table class="data-table">
            <thead><tr><th>Task</th><th>Project</th><th>Priority</th><th>Status</th></tr></thead>
            <tbody>
            @foreach (var t in Model.RecentTasks)
            {
            <tr>
                <td><a href="/Tasks/Details/@t.Id" class="task-link">@t.Title</a></td>
                <td style="color:#64748b;font-size:0.8rem;">@t.Project?.Name</td>
                <td>
                    @{
                        var priClass = t.Priority == TaskManager.Models.TaskPriority.High ? "badge-high" :
                                       t.Priority == TaskManager.Models.TaskPriority.Low  ? "badge-low" : "badge-medium";
                    }
                    <span class="badge @priClass">@t.Priority</span>
                </td>
                <td>
                    @{
                        var stClass = t.Status == TaskManager.Models.TaskStatus.Done       ? "badge-done" :
                                      t.Status == TaskManager.Models.TaskStatus.InProgress ? "badge-progress" :
                                      t.Status == TaskManager.Models.TaskStatus.Cancelled  ? "badge-cancelled" : "badge-todo";
                    }
                    <span class="badge @stClass">@t.Status</span>
                </td>
            </tr>
            }
            </tbody>
        </table>
        }
        else
        {
            <div class="empty-state"><i class="fas fa-inbox"></i>No tasks yet</div>
        }
    </div>

    <div class="card">
        <div style="padding:18px 20px;border-bottom:1px solid #f1f5f9;">
            <span style="font-weight:700;font-size:0.95rem;">Active Projects <span style="color:#94a3b8;font-weight:500;">(@Model.TotalProjects)</span></span>
        </div>
        <div style="padding:8px 12px;">
        @if (Model.ActiveProjects.Any())
        {
            @foreach (var p in Model.ActiveProjects)
            {
            <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 8px;border-bottom:1px solid #f8fafc;">
                <div style="display:flex;align-items:center;gap:10px;">
                    <div style="width:8px;height:8px;border-radius:50%;background:#22c55e;flex-shrink:0;"></div>
                    <span style="font-size:0.875rem;font-weight:500;">@p.Name</span>
                </div>
                <span class="badge badge-done">Active</span>
            </div>
            }
        }
        else
        {
            <div class="empty-state" style="padding:30px 20px;"><i class="fas fa-folder-open"></i>No projects</div>
        }
        </div>
        <div style="padding:12px 20px;border-top:1px solid #f1f5f9;">
            <a href="/Tasks/Create" class="btn btn-primary" style="width:100%;justify-content:center;">
                <i class="fas fa-plus"></i> New Task
            </a>
        </div>
    </div>
</div>
